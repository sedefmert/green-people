# ----- Network Setup -----
# Host and Port of the team laptop. 
# The Pi sends to laptop's SINK_HOST:SINK_PORT, the laptop relays that port to the sink on gl2.
SINK_HOST=192.168.178.170
SINK_PORT=5000 # Set 5001 on Pi.
# Fallback sink running directly on the laptop.
LOCAL_SINK_PORT=5001
WIFI_IFACE=wlan0

# ----- Power Measurement Setup -----
# power/power_server.py runs on the team laptop and records one power trace per run.
# shelly  = Shelly Plus Plug S V2 (SNPL-10112EU, Gen2 API) between the wall socket.
POWER_BACKEND=shelly
# laptop IP (where power_server.py listens) and its control port
POWER_HOST=192.168.178.170
POWER_PORT=5100
# Shelly Plus Plug S V2 IP address and polling rate
SHELLY_HOST=192.168.178.122
SHELLY_POLL_HZ=5
# Delay of the meter's readings behind real time(s) and subtracted from the trace timestamps before integration.
# measured with pilot/clock_check.py.
POWER_LAG_S=0.0
# Seconds the capture keeps running after the transmission phase, so lagged
# meter readings that belong to the end of the run are still recorded.
POWER_TAIL_S=3
# Directory on the laptop where power traces are stored. The relay copies them to gl2.
POWER_OUT_DIR=data/power

# ----- Raspberry Pi Setup -----
# Directory on the Raspberry Pi that contains wiki_S/, wiki_L/ and manifest.json
PAYLOAD_ROOT=/home/greenwarriors/greenwarriors-replication/data/payloads
# Directory on the Raspberry Pi where the relay stores temporary files (e.g., the payloads to be sent to gl2).
ARCHIVE_DIR=/dev/shm

# ----- Run Protocol -----
IDLE_S=60
COOLDOWN_S=120
SAMPLE_PERIOD_S=0.2
# Seconds discarded at the start of the idle window before computing idle power
IDLE_TRIM_S=5
TRANSFER_TIMEOUT_S=3600

# ----- GreenLab Server (gl2) Setup -----
JUMP_HOST=145.108.225.3:42224
JUMP_USER=gl_greenwarriors
GL2_HOST=gl2
GL2_USER=gl_greenwarriors
SSH_KEY=~/.ssh/id_ed25519
# Directory on gl2 where the relay stores logs.
GL2_OUT_DIR=greenwarriors/gl2_logs

# ---- Simulation -----
# 1 = fake vcgencmd / iw readings (so the whole pipeline can be dry-run)
# 0 = use real vcgencmd / iw readings
GW_SIMULATE=0
